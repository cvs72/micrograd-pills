--- a/site/pills/01-the-map.html
+++ b/site/pills/01-the-map.html
@@ -6,11 +6,8 @@
 <meta name="description" content="Where neural networks sit inside the map of artificial intelligence, zooming out one level at a time.">
 <title>01 · The AI Map · Knowledge pills</title>
 <link rel="stylesheet" href="../vendor/fonts/fonts.css">
+<link rel="stylesheet" href="../kit/pill.css">
 <style>
-  /* Left: a bracketed vertical list of cards, one colour per level, with the item we zoom out to on its left.
